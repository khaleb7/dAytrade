# Copy to %USERPROFILE%\.daytrade\daytrade.env or merge into alpaca.env
# Secrets stay OUTSIDE the Project store. Never commit real keys.

APCA_API_KEY_ID=YOUR_PAPER_KEY_ID
APCA_API_SECRET_KEY=YOUR_PAPER_SECRET
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Required for live SDK local fan-out (single A1 / grok-4.7)
CURSOR_API_KEY=YOUR_CURSOR_API_KEY

# DAYTRADE_STORE=C:\path\to\store
# DAYTRADE_PYTHON=py
# DAYTRADE_NODE=node
# DAYTRADE_ENV_FILE=%USERPROFILE%\.daytrade\alpaca.env

# Discord run alerts (optional; soft-fail if unset). Never commit the real URL.
# DAYTRADE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Fan-out / proposal wait minutes (default 20 on 30m ticks)
# DAYTRADE_PROPOSAL_WAIT_MINUTES=20
