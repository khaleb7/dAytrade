# Copy to %USERPROFILE%\.daytrade\alpaca.env  (OUTSIDE the Project store)
# Never commit real keys. Never place this file under the DayTrade store.

APCA_API_KEY_ID=YOUR_PAPER_KEY_ID
APCA_API_SECRET_KEY=YOUR_PAPER_SECRET
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Cursor SDK local fan-out (required for live A1-A5 agents)
CURSOR_API_KEY=YOUR_CURSOR_API_KEY

# Optional overrides
# DAYTRADE_STORE=C:\path\to\bc-7a9f3369-d383-44f7-b5ec-0d1ac69e76fb
# DAYTRADE_PYTHON=py
# DAYTRADE_NODE=node
